          "title": "Global Active Power",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "from(bucket: \"energy-bucket\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"energy_readings\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"globalActivePower\")\r\n  |> filter(fn: (r) => r[\"deviceId\"] == \"smart-meter-1\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> yield(name: \"globalActivePower\")"
